############################################################
# 12. Identify Cluster Markers
############################################################
markers <- FindAllMarkers(
  seurat_obj,
  only.pos = TRUE,
  min.pct = 0.25,
  logfc.threshold = 0.25
)

# View top markers per cluster
top_markers <- markers %>%
  group_by(cluster) %>%
  top_n(n = 5, wt = avg_log2FC)

# Save markers
write.csv(markers, "results/cluster_markers.csv")

